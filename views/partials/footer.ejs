<footer>
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <div class="brand" style="margin-bottom:18px;">
        <span class="brand-mark">
          <% if (settings.logo_url) { %><img src="<%= settings.logo_url %>" alt="<%= settings.site_name %> logo">
          <% } else { %><%- include('emblem') %><% } %>
        </span>
        <span class="brand-text">
          <span class="name"><%= settings.site_name %></span>
          <span class="sub"><%= settings.tagline %></span>
        </span>
      </div>
      <p>The youth fellowship of the Diocese of Akure, raising young people for Christ through worship, fellowship, discipleship and service.</p>
      <div class="social-row">
        <% if (settings.facebook_url) { %><a href="<%= settings.facebook_url %>" aria-label="Facebook">f</a><% } %>
        <% if (settings.instagram_url) { %><a href="<%= settings.instagram_url %>" aria-label="Instagram">ig</a><% } %>
        <% if (settings.twitter_url) { %><a href="<%= settings.twitter_url %>" aria-label="X">x</a><% } %>
        <% if (settings.youtube_url) { %><a href="<%= settings.youtube_url %>" aria-label="YouTube">yt</a><% } %>
        <% if (settings.whatsapp_url) { %><a href="<%= settings.whatsapp_url %>" aria-label="WhatsApp">wa</a><% } %>
      </div>
    </div>
    <div>
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/programmes">Programmes</a></li>
        <li><a href="/news">News</a></li>
        <li><a href="/media">Gallery</a></li>
        <li><a href="/contact">Contact Us</a></li>
      </ul>
    </div>
    <div>
      <h4>Explore</h4>
      <ul>
        <li><a href="/archdeaconries">Archdeaconries</a></li>
        <li><a href="/executives">Diocesan Executives</a></li>
        <li><a href="/patrons">Patrons &amp; Patroness</a></li>
        <li><a href="/magazine">Magazine</a></li>
        <li><a href="/newsletter">Newsletter</a></li>
        <li><a href="/media#publications">Publications</a></li>
        <li><a href="/media#videos">YouTube</a></li>
        <li><a href="/donate">Donate</a></li>
      </ul>
    </div>
    <div>
      <h4>Contact</h4>
      <p><%= settings.office_address %></p>
      <p><%= settings.email_1 %></p>
      <p><%= settings.phone_1 %></p>
    </div>
  </div>
  <div class="footer-bottom">Copyright &copy; <span id="copyYear"></span> AYF Akure — All Rights Reserved.</div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
