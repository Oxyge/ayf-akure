<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Login | AYF Akure</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/admin.css">
<style>
  .login-body{display:flex;align-items:center;justify-content:center;min-height:100vh;overflow:auto;}
  .login-box{position:relative;z-index:1;width:100%;max-width:400px;margin:20px;padding:40px 36px 34px;}
  .login-box .mark{width:46px;height:46px;border-radius:14px;background:rgba(255,255,255,.92);display:grid;place-items:center;color:#0e4da4;font-weight:800;font-size:.82rem;margin-bottom:22px;box-shadow:0 8px 20px rgba(0,0,0,.28);}
  .login-box h1{font-size:1.7rem;font-weight:500;margin:0 0 6px;}
  .login-box p{margin:0 0 24px;font-size:.88rem;}
  .login-box .field{margin-bottom:16px;}
  .login-box label{display:block;font-size:.76rem;font-weight:600;color:var(--t2);margin-bottom:6px;}
  .login-box .btn{width:100%;justify-content:center;margin-top:6px;}
  .error{background:rgba(255,122,122,.16);border:1px solid rgba(255,122,122,.5);color:#ffd0d0;padding:10px 14px;font-size:.84rem;margin-bottom:18px;border-radius:13px;}
</style>
</head>
<body class="admin-body login-body">
  <div class="bg-glow" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="login-box glass">
    <div class="mark">AYF</div>
    <h1>Welcome back</h1>
    <p>Sign in to manage the AYF Akure website.</p>
    <% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>
    <form method="POST" action="/admin/login">
      <div class="field"><label for="username">Username</label><input id="username" name="username" type="text" required autofocus autocomplete="username"></div>
      <div class="field"><label for="password">Password</label><input id="password" name="password" type="password" required autocomplete="current-password"></div>
      <button type="submit" class="btn btn-solid">Sign in</button>
    </form>
  </div>
</body>
</html>
